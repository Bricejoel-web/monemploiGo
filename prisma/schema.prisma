// Base de données : Postgres (Neon). L'URL de connexion n'est pas déclarée
// ici (Prisma 7 + adaptateurs) mais dans prisma.config.ts (CLI/migrations,
// DIRECT_URL non poolée) et via l'adaptateur passé au PrismaClient (runtime,
// DATABASE_URL poolée) — voir src/lib/db/client.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CvCategory {
  STANDARD
  PREMIUM
  ATS
  GERMAN_ATS
  CANADA
  CANADA_ATS
}

enum DocumentType {
  CV
  COVER_LETTER
  BEWERBUNGSBRIEF
}

enum DocumentStatus {
  DRAFT
  PAID
  // Document Pro finalisé : téléchargeable, verrouillé, compté dans le quota
  // de la période (jamais utilisé pour les documents particuliers).
  FINALIZED
}

enum PaymentProvider {
  CINETPAY
  MTN_MOMO
  ORANGE_MONEY
  MONETBIL
  NOTCHPAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// Objet d'un paiement : un document à l'unité (particulier) ou une période
// d'abonnement Pro Starter (espace Pro).
enum PaymentKind {
  DOCUMENT
  PRO_SUBSCRIPTION
}

model User {
  id               String          @id @default(cuid())
  // Incrémentée à chaque réinitialisation du mot de passe : les sessions
  // émises avec une version antérieure (autres appareils) sont refusées.
  sessionVersion   Int             @default(0)
  // Adresse e-mail prouvée (lien reçu et ouvert). Exigée pour l'accès
  // administrateur : sinon n'importe qui inscrit avec l'adresse d'un
  // administrateur obtiendrait ses droits.
  emailVerifiedAt  DateTime?
  email            String          @unique
  passwordHash     String
  name             String?
  // Consentement explicite (case décochée par défaut) pour recevoir des
  // e-mails de conseils/offres — recueilli dès l'inscription même si
  // l'envoi de ce type d'e-mail n'est pas encore implémenté, pour ne pas
  // avoir à redemander ce consentement rétroactivement le jour où la
  // fonctionnalité existera.
  marketingConsent Boolean         @default(false)
  // Version des CGU (voir src/data/legal/legal-config.ts, TERMS_VERSION)
  // acceptées à l'inscription, et date de cette acceptation — permet de
  // savoir quelle version un utilisateur a acceptée si les CGU évoluent.
  termsVersion     String?
  termsAcceptedAt  DateTime?
  // Parrainage (voir src/lib/referral) : code personnel stable, créé à la
  // première visite de la page « Parrainer & gagner » ; et, pour une
  // personne recommandée, son parrain et le domaine du lien, fixés une fois
  // pour toutes à l'inscription (jamais modifiables ensuite).
  referralCode     String?         @unique
  referredById     String?
  referralDomain   ReferralDomain?
  referredAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  documents Document[]
  payments  Payment[]
  review    Review?

  // Espace MonEmploiGo Pro éventuel : même compte (mêmes identifiants),
  // données strictement séparées de l'espace particulier. Supprimer le
  // compte supprime l'espace Pro (décision du 2026-09-30).
  professionalAccount ProfessionalAccount?
  passwordResetTokens PasswordResetToken[]

  referredBy              User?                    @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers           User[]                   @relation("Referrals")
  commissionsEarned       ReferralCommission[]     @relation("CommissionReferrer")
  commissionsCaused       ReferralCommission[]     @relation("CommissionReferred")
  withdrawalRequests      WithdrawalRequest[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([referredById])
}

enum ReferralDomain {
  CAMEROUN
  ALLEMAGNE
  CANADA
  GENERAL
}

enum ReferralCommissionStatus {
  VALID
  // Annulée (remboursement…) : conservée pour l'historique, plus comptée.
  CANCELLED
}

// Commission de parrainage : 200 FCFA fixes par document éligible payé par
// une personne recommandée. UNE seule par paiement (paymentId unique) :
// créée dans la même transaction que la confirmation du paiement, une
// confirmation répétée (webhook rejoué…) n'en crée jamais une deuxième.
// Les liens deviennent nuls si un compte ou un paiement disparaît : la
// trace financière (montant, type, dates) est conservée, y compris quand le
// parrain supprime son compte (décision de l'utilisateur du 2026-10-06).
model ReferralCommission {
  id             String                   @id @default(cuid())
  referrerId     String?
  referredUserId String?
  paymentId      String?                  @unique
  documentType   DocumentType
  amountFcfa     Int
  status         ReferralCommissionStatus @default(VALID)
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime                 @default(now())

  referrer     User?              @relation("CommissionReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  referredUser User?              @relation("CommissionReferred", fields: [referredUserId], references: [id], onDelete: SetNull)
  payment      Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  auditLogs    ReferralAuditLog[]

  @@index([referrerId, status])
}

enum WithdrawalMethod {
  MTN_MOMO
  ORANGE_MONEY
}

enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

// Demande de retrait des gains (minimum 500 FCFA), payée À LA MAIN par
// l'administrateur via Mobile Money : aucun paiement automatique. Le
// montant est réservé dès la demande (solde disponible = commissions
// valides − retraits en attente ou payés), sous verrou du compte. Le compte
// ne peut pas être supprimé tant qu'une demande est en attente ; les
// demandes traitées sont conservées (détachées) après sa suppression.
model WithdrawalRequest {
  id            String           @id @default(cuid())
  userId        String?
  // Code de parrainage du bénéficiaire au moment de la demande (historique).
  userCode      String?
  amountFcfa    Int
  method        WithdrawalMethod
  phoneNumber   String
  status        WithdrawalStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  processedAt   DateTime?
  processedById String?

  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  auditLogs ReferralAuditLog[]

  @@index([userId, status])
  @@index([status, createdAt])
}

// Journal des décisions de l'administrateur (retrait payé ou refusé,
// commission annulée) : qui, quoi, avant/après, quand. Conservé même si la
// demande ou la commission disparaît.
model ReferralAuditLog {
  id           String   @id @default(cuid())
  withdrawalId String?
  commissionId String?
  adminId      String
  adminEmail   String
  action       String
  oldStatus    String
  newStatus    String
  amountFcfa   Int
  // Code de parrainage du bénéficiaire, pour l'historique.
  userCode     String?
  createdAt    DateTime @default(now())

  withdrawal WithdrawalRequest?  @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)
  commission ReferralCommission? @relation(fields: [commissionId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

enum ProfessionalAccountStatus {
  ACTIVE
  // Suspension par MonEmploiGo (CGU Pro, article 15).
  SUSPENDED
}

// Espace professionnel MonEmploiGo Pro (voir docs/ROADMAP.md). L'e-mail de
// connexion et le mot de passe restent ceux du `User` : `email` est
// l'adresse de contact professionnelle de la structure.
model ProfessionalAccount {
  id              String                    @id @default(cuid())
  userId          String                    @unique
  companyName     String
  managerName     String
  email           String
  phone           String
  // Logo facultatif (photo de profil de la structure), affiché uniquement
  // dans l'espace Pro, jamais sur les documents des candidats. Image
  // PNG, JPEG ou WebP réduite à 256 px, revérifiée côté serveur.
  logoDataUrl     String?
  status          ProfessionalAccountStatus @default(ACTIVE)
  // Versions des CGU générales et des CGU Pro acceptées à la création de
  // l'espace (case obligatoire), et date de cette acceptation.
  termsVersion    String
  proTermsVersion String
  termsAcceptedAt DateTime
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  documents     Document[]
  candidates    ProfessionalCandidate[]
  payments      Payment[]
  expiryNotices ProExpiryNotice[]
}

enum SubscriptionPlan {
  PRO_STARTER
}

// Une ligne par période payée (30 jours, sans renouvellement automatique).
// Le statut n'est jamais stocké : il se déduit des dates (actif, lecture
// seule 90 jours après expiration...), voir src/lib/pro/subscription.ts.
// Un renouvellement anticipé crée la période suivante, accolée à la fin de
// la période en cours. `documentsUsed` : documents finalisés sur la période,
// incrémenté seulement s'il reste du quota (phase 6).
model Subscription {
  id                    String           @id @default(cuid())
  professionalAccountId String
  plan                  SubscriptionPlan @default(PRO_STARTER)
  priceFcfa             Int
  currency              String           @default("XAF")
  startsAt              DateTime
  expiresAt             DateTime
  documentsUsed         Int              @default(0)
  // Paiement qui a activé cette période : unique, car un même paiement ne
  // peut activer qu'une seule période (CGU Pro, article 7).
  paymentId             String?          @unique
  createdAt             DateTime         @default(now())

  professionalAccount ProfessionalAccount @relation(fields: [professionalAccountId], references: [id], onDelete: Cascade)
  payment             Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([professionalAccountId, expiresAt])
}

enum CandidateStatus {
  ACTIVE
  ARCHIVED
}

// Candidat suivi par un professionnel. Toujours rattaché à UN compte Pro :
// toute lecture filtre par `professionalAccountId` (isolation des données).
model ProfessionalCandidate {
  id                    String          @id @default(cuid())
  professionalAccountId String
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  destinationCountry    String?
  professionalField     String?
  applicationType       String?
  educationLevel        String?
  languages             String?
  germanLevel           String?
  status                CandidateStatus @default(ACTIVE)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  professionalAccount ProfessionalAccount @relation(fields: [professionalAccountId], references: [id], onDelete: Cascade)
  documents           Document[]

  @@index([professionalAccountId, status])
}

// Lien « mot de passe oublié » : seule l'empreinte SHA-256 du jeton est
// stockée (le jeton lui-même n'existe que dans l'e-mail), valable 1 heure,
// utilisable une seule fois.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Avis d'un client sur le service (1 à 5 étoiles + commentaire facultatif).
// UN SEUL avis par client, pour le service en général : le demander à
// chaque document agacerait ceux qui en créent souvent. Il est demandé
// après le premier document payé et reste modifiable. Le document à
// l'origine de l'avis est gardé pour le contexte (type, catégorie et
// modèle recopiés : le document lui-même est supprimé au bout de 3
// semaines, voir retention.ts). Supprimer son compte supprime son avis.
model Review {
  id           String       @id @default(cuid())
  userId       String       @unique
  documentId   String?
  rating       Int
  comment      String?
  documentType DocumentType
  category     CvCategory?
  templateSlug String
  locale       String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// Les modèles de CV et de lettres de motivation (catalogue de 215 CV et 100
// lettres) sont des données statiques générées par code — voir
// src/lib/cv/catalog.ts — et ne sont donc pas dupliqués en base. Chaque
// document utilisateur référence simplement le "slug" du modèle utilisé.
model Document {
  id           String         @id @default(cuid())
  userId       String
  type         DocumentType
  templateSlug String
  category     CvCategory?
  title        String
  contentJson  String
  includePhoto Boolean        @default(false)
  photoDataUrl String?
  status       DocumentStatus @default(DRAFT)
  // Date de confirmation du paiement : le document reste retéléchargeable
  // gratuitement pendant 3 semaines à partir d'ici, puis est supprimé
  // automatiquement (voir src/lib/documents/retention.ts).
  paidAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Document de l'espace Pro (phase 5) : rattaché au compte Pro et au
  // candidat. Nuls pour tous les documents particuliers. ⚠️ Les pages
  // particulier doivent filtrer `professionalAccountId: null` dès que des
  // documents Pro existent (séparation stricte des deux espaces).
  professionalAccountId String?
  candidateId           String?
  // Date de finalisation d'un document Pro (consommation du quota).
  finalizedAt           DateTime?

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalAccount ProfessionalAccount?   @relation(fields: [professionalAccountId], references: [id], onDelete: Cascade)
  candidate           ProfessionalCandidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  payments Payment[]
  reviews  Review[]

  @@index([userId])
  @@index([status, paidAt])
  @@index([status, updatedAt])
  @@index([professionalAccountId])
  @@index([candidateId])
}

// `documentId` devient nul quand le document est supprimé automatiquement
// après sa période de conservation : la trace du paiement (montant, date,
// référence prestataire, utilisateur) est conservée pour la comptabilité et
// les éventuels litiges, sans garder le contenu du document lui-même.
model Payment {
  id                    String          @id @default(cuid())
  userId                String
  kind                  PaymentKind     @default(DOCUMENT)
  // Renseigné pour un abonnement Pro (kind = PRO_SUBSCRIPTION).
  professionalAccountId String?
  documentId            String?
  provider              PaymentProvider
  amountFcfa            Int
  status                PaymentStatus   @default(PENDING)
  providerRef           String?
  phoneNumber           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  document            Document?            @relation(fields: [documentId], references: [id], onDelete: SetNull)
  professionalAccount ProfessionalAccount? @relation(fields: [professionalAccountId], references: [id], onDelete: SetNull)

  referralCommission ReferralCommission?
  subscription       Subscription?

  @@index([userId])
  @@index([documentId])
  @@index([professionalAccountId])
}

// Traces de paiement Pro (référence, montant, devise, date, statut, offre et
// nom de la structure), conservées séparément, sans clé étrangère et sans
// aucune donnée de candidat : elles survivent à la suppression de l'espace
// Pro ou du compte (politique de confidentialité, section 17).
model ProPaymentRecord {
  id          String           @id @default(cuid())
  paymentId   String           @unique
  providerRef String?
  amountFcfa  Int
  currency    String           @default("XAF")
  status      PaymentStatus
  plan        SubscriptionPlan @default(PRO_STARTER)
  companyName String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Avertissements d'expiration Pro déjà envoyés (jour de l'expiration, puis
// 30 et 7 jours avant la suppression) : un seul envoi par échéance.
enum ProExpiryNoticeKind {
  EXPIRED
  DELETION_IN_30_DAYS
  DELETION_IN_7_DAYS
}

model ProExpiryNotice {
  id                    String              @id @default(cuid())
  professionalAccountId String
  kind                  ProExpiryNoticeKind
  expiredAt             DateTime
  emailSent             Boolean             @default(false)
  createdAt             DateTime            @default(now())

  professionalAccount ProfessionalAccount @relation(fields: [professionalAccountId], references: [id], onDelete: Cascade)

  @@unique([professionalAccountId, kind, expiredAt])
}

// Compteurs des limites de tentatives (connexion, inscription, paiement…),
// partagés par toutes les instances du site. La clé est une empreinte
// SHA-256 : ni adresse IP ni e-mail en clair. Lignes expirées supprimées par
// la tâche quotidienne.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// Liens de vérification d'adresse e-mail : seule l'empreinte SHA-256 du
// jeton est stockée ; 1 heure, usage unique, lié au compte connecté.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
