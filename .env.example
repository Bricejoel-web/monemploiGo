# Base de données (SQLite en local ; passer à une URL Postgres en production)
DATABASE_URL="file:./prisma/dev.db"

# Clé secrète utilisée pour signer les cookies de session (générer une valeur aléatoire longue)
SESSION_SECRET="change-me-to-a-long-random-string"

# Adresse publique du site (utilisée pour les URLs de retour/webhook de paiement)
APP_BASE_URL="http://localhost:3000"

# Monetbil (passerelle par défaut) — agrège MTN Mobile Money / Orange Money
# et d'autres opérateurs sans négocier d'accès direct payant auprès de
# chaque opérateur. Créer un service sur https://www.monetbil.com/services/create
# puis récupérer la "Service key" (identifie le service, transmise à chaque
# paiement) et le "Service secret" (jamais transmis, sert uniquement à
# signer/vérifier les notifications reçues du serveur Monetbil).
MONETBIL_SERVICE_KEY=""
MONETBIL_SERVICE_SECRET=""

# CinetPay — conservée en réserve (même principe d'agrégateur), non utilisée
# par défaut depuis le passage à Monetbil. Créer un compte marchand gratuit
# sur https://cinetpay.com puis récupérer la clé API et l'ID de site depuis
# le tableau de bord.
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""

# Notch Pay — troisième passerelle ajoutée en réserve (pas utilisée par
# défaut, voir docs/ROADMAP.md), en cours de test en sandbox uniquement.
# Créer un compte sur https://business.notchpay.co/register puis récupérer,
# dans Settings > API Keys :
#   - NOTCHPAY_PUBLIC_KEY et NOTCHPAY_SECRET_KEY : utiliser les valeurs qui
#     commencent par "test_" pendant les essais en sandbox (ne jamais
#     mélanger avec les valeurs de production).
#   - NOTCHPAY_WEBHOOK_HASH : la "webhook hash key" affichée dans ce même
#     écran (distincte de la clé secrète) — sert uniquement à vérifier la
#     signature des notifications reçues, jamais transmise à Notch Pay.
NOTCHPAY_PUBLIC_KEY=""
NOTCHPAY_SECRET_KEY=""
NOTCHPAY_WEBHOOK_HASH=""

# MTN Mobile Money — accès direct optionnel, pour plus tard si besoin
# (sandbox MTN MoMo API — https://momodeveloper.mtn.com)
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENVIRONMENT="sandbox"

# Orange Money — accès direct optionnel, pour plus tard si besoin
# (Orange Money Web Payment API)
ORANGE_MONEY_BASE_URL="https://api.orange.com/orange-money-webpay/dev/v1"
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""

# Mode paiement : "mock" (simulation locale, par défaut) ou "live"
PAYMENT_MODE="mock"

# Unsplash (photos de profil sous licence commerciale gratuite pour les
# aperçus de modèles) — créer une clé sur https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=""

# OpenAI (optionnel) — amélioration facultative de la rédaction du
# Bewerbungsbrief ("Régénérer avec l'IA"). Sans cette clé, le site continue
# de fonctionner normalement : un générateur par règles produit déjà une
# lettre correcte à partir des informations saisies. Créer une clé sur
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
